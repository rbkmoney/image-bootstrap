{
    "variables": {
        "docker-registry": "{{env `REGISTRY`}}",
	"org-name": "{{env `ORG_NAME`}}",
	"base-dir": "{{env `PWD`}}",
        "files-dir": "{{env `PWD`}}/files/",
        "image-tag": null
    },
    "builders": [
        {
            "type": "docker",
            "image": "{{user `docker-registry`}}/{{ user `org-name`}}/stage3-amd64-hardened-nomultilib",
            "run_command": ["-d", "-i", "-t", "--privileged=true", "{{.Image}}", "/bin/bash"],
            "volumes": {
                "{{user `files-dir`}}": "/tmp/data:ro",
                "{{user `base-dir`}}/portage": "/var/db/repos/gentoo:ro"
            },
            "pull": "false",
            "commit": "true"
        }
    ],
    "provisioners": [
        {
            "type": "shell",
            "script": "{{user `files-dir`}}/packer.sh"
        }
    ],
    "post-processors": [
        {
            "type": "docker-tag",
            "repository": "{{user `docker-registry`}}/{{ user `org-name`}}/bootstrap",
            "tag": "{{user `image-tag`}}"
        }
    ]
}
